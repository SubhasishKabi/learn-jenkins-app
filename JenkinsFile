pipeline{
  agent any
  stages{
    stage('Build'){
      agent{
        docker{
          image 'node:18-alpine'
        }
      }
      steps{
        echo 'Building...'
        sh '''
          ls -la
          node --version
          npm --version
          npm ci 
          npm run build 
          ls -la
        '''
      }
    }
    stage('Test') {
      agent {
          docker {
              image 'node:18-alpine'
              reuseNode true
          }
      }

      steps {
          echo 'Testing...'

          sh '''
              test -f build/index.html
              echo "index.html exists"

              npm test -- --watchAll=false
          '''
      }
}
    stage('Deploy'){
      steps{
        echo 'Deploying...'
      }
    }
  }
}