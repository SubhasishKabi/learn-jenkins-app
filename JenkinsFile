pipeline{
  agent any
  stages{
    stage('Build'){
      agent{
        docker{
          image 'node:18-alpine'
          reuseNode true
        }
      }
      steps{
        echo 'Building...'
        sh '''
          ls -la
          node --version
          npm --version
          npm ci 
          npm run build 
          ls -la
        '''
      }
    }
//     stage('Test') {
//       agent {
//           docker {
//               image 'node:18-alpine'
//           }
//       }

//       steps {
//           echo 'Testing...'

//           sh '''
//               test -f build/index.html
//               echo "index.html exists"

//               npm test
//           '''
//       }
// }
    stage('Test') {
    agent {
        docker {
            image 'node:18-alpine'
        }
    }

    steps {
        echo 'Testing...'

        sh '''
            test -f build/index.html
            echo "index.html exists"

            npm test -- --watchAll=false

            echo "Checking JUnit report..."
            ls -la test-results
            find . -name "junit.xml" -type f
        '''
    }
}
    stage('Deploy'){
      steps{
        echo 'Deploying...'
      }
    }
  }
  post{
    always{
      junit 'test-results/junit.xml'
    }
  }
}