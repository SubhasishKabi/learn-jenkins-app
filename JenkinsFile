pipeline {
    agent any

    stages {

        // stage('Build') {
        //     agent {
        //         docker {
        //             image 'node:18-alpine'
        //             reuseNode true
        //         }
        //     }

        //     steps {
        //         echo 'Building...'

        //         sh '''
        //             ls -la
        //             node --version
        //             npm --version

        //             npm ci
        //             npm run build

        //             ls -la
        //         '''
        //     }
        // }

        stage('Test') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }

            steps {
                echo 'Running Jest tests...'

                sh '''
                    test -f build/index.html
                    echo "index.html exists"

                    npm test
                     echo "===== AFTER TEST ====="
                     ls -la test-results
                     find . -name "junit.xml" -type f
                '''
            }
        }

        stage('E2E') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.39.0-jammy'
                    reuseNode true
                }
            }

            steps {
                // sh '''
                //     npm install serve
                //     node_modules/.bin/serve -s build &
                //     sleep 10
                //     npx playwright test --reporter=html
                // '''
                sh '''
                    echo "===== BEFORE npm install ====="
                    find . -name junit.xml -type f

                    npm install serve

                    echo "===== AFTER npm install ====="
                    find . -name junit.xml -type f

                    node_modules/.bin/serve -s build &

                    echo "===== AFTER serve ====="
                    find . -name junit.xml -type f

                    sleep 10

                    npx playwright test --reporter=html

                    echo "===== AFTER Playwright ====="
                    find . -name junit.xml -type f
                '''
            }
        }
    }

    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}